# Copy this to .env
# When running via docker-compose, DATABASE_URL is overridden to point at the
# "db" service automatically. This value is only used for local (non-docker)
# runs against a Postgres instance on localhost.
DATABASE_URL=postgresql+psycopg://xthings:xthings_dev_password@localhost:5432/xthings_db

APP_NAME=Xthings Attendance API
APP_ENV=development
DEBUG=true

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
